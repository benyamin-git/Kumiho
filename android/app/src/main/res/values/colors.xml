<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      First-frame neutrals, qualified for night mode by values-night/colors.xml.
      The accent palette is generated by the engine (Go) and applied in Compose;
      these keep the splash and the palette-error surface from flashing a
      Material default. The names are the house roles, not raw accents.
    -->
    <color name="kumiho_background">#fffbfe</color>
    <color name="kumiho_on_surface">#1c1b1f</color>

    <!--
      The adaptive icon background: the house blue light primary, named so the
      adaptive XML never carries a component hex.
    -->
    <color name="ic_launcher_background">#35639c</color>
</resources>
