    <!-- Step 3: Android permissions. -->
    <string name="permissions_title">Android permissions</string>
    <string name="permissions_intro">Two Android permissions make the tunnel usable. You can finish setup without either of them; Kumiho asks again when you connect.</string>
    <string name="permissions_vpn_title">VPN permission</string>
    <string name="permissions_vpn_text">Android asks you to approve a VPN before any app can carry traffic. Granting it now saves a prompt on your first connect.</string>
    <string name="permissions_vpn_action">Allow VPN</string>
    <string name="permissions_vpn_granted">Granted</string>
    <string name="permissions_vpn_missing">Not granted</string>
    <string name="permissions_vpn_denied">Android did not grant the VPN permission. You can still finish setup; Kumiho asks again when you connect.</string>
    <string name="permissions_notifications_title">Notifications</string>
    <string name="permissions_notifications_text">Kumiho shows a status notification while the tunnel is up, with a Disconnect action. Without it the tunnel still runs; Android just cannot show the status or the action.</string>
    <string name="permissions_notifications_action">Allow notifications</string>
    <string name="permissions_notifications_settings">Open notification settings</string>
    <string name="permissions_notifications_granted">Allowed</string>
    <string name="permissions_notifications_missing">Not allowed</string>
    <string name="permissions_notifications_denied">Notifications are turned off for Kumiho. You can allow them in Android settings at any time.</string>
    <string name="permissions_note">Both permissions can be changed later in Android settings.</string>

    <!-- Step 4: Always-on guidance. -->
    <string name="always_on_intro">Android can start Kumiho\'s VPN on its own, including after a reboot. Kumiho never changes this for you: the switch lives in Android\'s VPN settings.</string>
    <string name="always_on_always_title">Always-on VPN</string>
    <string name="always_on_always_text">When Always-on VPN is on, Android starts Kumiho whenever no VPN is connected, and Kumiho connects if you are signed in. If you are signed out it asks you to sign in instead of connecting.</string>
    <string name="always_on_lockdown_title">Lockdown</string>
    <string name="always_on_lockdown_text">Lockdown is stricter: Android blocks all traffic while Kumiho is not connected. Kumiho shows the real state and never works around it.</string>
    <string name="always_on_row_state">Android state</string>
    <string name="always_on_state_on">On</string>
    <string name="always_on_state_off">Off</string>
    <string name="always_on_open_settings">Open Android VPN settings</string>
    <string name="always_on_connect_hint">You are signed in and the VPN permission is granted, so Finish can connect straight away.</string>
    <string name="always_on_connect_hint_needs_vpn">Connect now needs the VPN permission: grant it when Kumiho asks on your first connect.</string>
    <string name="always_on_connect_hint_needs_sign_in">Connect now needs a signed-in Firefox Account. Finish, then sign in from Account.</string>
    <string name="always_on_connect_hint_needs_both">Connect now needs the VPN permission and a signed-in Firefox Account. Finish, then grant it and sign in.</string>
    <string name="always_on_finish_note">Finish saves the setup and opens the dashboard.</string>

