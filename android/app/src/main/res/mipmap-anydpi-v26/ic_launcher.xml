<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. Background is the house blue light primary as a
     named colour; the artwork fills the 72dp visible viewport of the 108dp
     foreground so launcher masks never clip the fox. The monochrome layer
     feeds Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
