<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. Background is the house blue light primary as a
     named colour; the fox is scaled to a 32dp radius, inside the 33dp
     safe-zone circle of the 108dp foreground. The monochrome layer feeds
     Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
