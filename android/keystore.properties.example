# Copy this file to android/keystore.properties before a signed release.
# The real file is git-ignored; never commit it or the keystore.
#
# storeFile may be absolute, or relative to the android/ project directory.
# Keep the keystore and this file outside the repository, with mode 600.
storeFile=/absolute/path/to/kumiho-android-release.jks
storePassword=replace-me
keyAlias=kumiho
keyPassword=replace-me
